# Template only. Copy to .env, .env.staging or .env.production and update the values.
#
# NOT A PLACE FOR SECRETS. Every variable app.config.ts reads ends up in the app
# manifest, which ships inside the binary and can be read by anyone who installs the
# app. API keys, signing tokens and anything else that must stay private belong in EAS
# at "secret" visibility, or behind a server the app talks to.
#
# The real values live in EAS (expo.dev), one set per environment:
#   development → EAS "development"   staging → EAS "preview"   production → EAS "production"
#
#   pnpm env:setup                         # first run: pull from EAS, or fill in by hand
#   pnpm env:pull [variant]                # refresh the local copies
#   pnpm env:push [variant]                # publish local values to EAS
#   pnpm env:exec staging -- pnpm ios:stg  # run against EAS values, no file involved
#
# Anything already set in the shell wins: app.config.ts fills in from the env file
# without overwriting, so env:exec and CI injection are never shadowed by a stale file.

# Environment
# One of: development | staging | production (lowercase).
# An unrecognised value silently falls back to development, so a typo here yields a
# development build with no warning.
APP_VARIANT=development

# App Configuration
APP_NAME=MyApp

# Version
VERSION_CODE=1
VERSION_NAME=1.0.0

# API Configuration
#
# Must be https:// for the staging and production variants — both the build gate
# (scripts/check-env.js) and the app at startup reject cleartext there. http:// is
# accepted only for development, e.g. http://localhost:3000 against a local server.
#
# This previously defaulted to http://localhost:3000, so copying this file and editing
# only the host produced a cleartext production build. Android blocks that outright
# while iOS may allow it on a local network, so it fails completely on one platform and
# appears to work on the other.
API_URL=https://api.example.com

# Expo Updates Configuration
# Get these from your Expo project settings (expo.dev)
EXPO_PROJECT_ID=your-project-id-here
EXPO_UPDATE_URL=https://u.expo.dev/your-project-id-here
# One of: development | staging | production
EXPO_UPDATE_CHANNEL=development

# Add your other environment variables below. Nothing reads them until you plumb them
# through app.config.ts -> extra and src/shared/constants — an unread variable here is
# not a feature flag, it is a typo waiting to be debugged.


