# This is an example environment file
# Copy this file to .env, .env.staging, or .env.production and update the values

# Environment
# One of: development | staging | production (lowercase).
# An unrecognised value silently falls back to development, so a typo here yields a
# development build with no warning.
APP_VARIANT=development

# App Configuration
APP_NAME=MyApp

# Version
VERSION_CODE=1
VERSION_NAME=1.0.0

# API Configuration
API_URL=http://localhost:3000

# Expo Updates Configuration
# Get these from your Expo project settings (expo.dev)
EXPO_PROJECT_ID=your-project-id-here
EXPO_UPDATE_URL=https://u.expo.dev/your-project-id-here
# One of: development | staging | production
EXPO_UPDATE_CHANNEL=development

# Add your other environment variables below
GOOGLE_API_KEY=
FACEBOOK_APP_ID=
SOME_OTHER_VAR=


